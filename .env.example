# --- LLM Provider (optional — auto-detected from credentials if not set) ---
# LLM_PROVIDER="claude"         # or: gemini

# --- Claude authentication (default provider — choose one) ---

# Option A: Direct API key
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Option B: Vertex AI (reads ~/.claude/settings.json automatically)
# If your ~/.claude/settings.json contains CLAUDE_CODE_USE_VERTEX=1 and
# ANTHROPIC_VERTEX_PROJECT_ID, the framework picks it up with no extra config.
# Override the Vertex region if CLOUD_ML_REGION is set to "global":
# ANTHROPIC_VERTEX_REGION="us-east5"

# Optional: Override Claude models (smart defaults are chosen per auth method)
# CLAUDE_MODEL="claude-sonnet-4-6"
# CLAUDE_VISION_MODEL="claude-haiku-4-5"
# CLAUDE_REPORT_MODEL="claude-haiku-4-5"
# CLAUDE_SCENARIO_MODEL="claude-sonnet-4-6"
# SCENARIO_MODEL="model-name"      # provider-agnostic override for PR scenario generation

# --- Gemini authentication (alternative provider — choose one) ---

# Option A: API key
# GOOGLE_API_KEY="your_gemini_api_key_here"

# Option B: OAuth credentials (no env var needed)
# If GOOGLE_API_KEY is not set, the framework loads ~/.gemini/oauth_creds.json
# produced by: gemini auth login

# Optional: Override Gemini models
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_VISION_MODEL="gemini-2.5-flash"
# GEMINI_REPORT_MODEL="gemini-2.5-pro"
# GEMINI_SCENARIO_MODEL="gemini-2.5-pro"

# --- Application under test ---
APP_URL="http://localhost:5601"
APP_USERNAME="admin"
APP_PASSWORD="changeme"

APP_CONFIG="./config.yaml"
MCP_SERVERS_CONFIG="./mcp_servers.json"

AGENT_SKILLS_ROOT="./agent-skills"
AGENT_SKILL_SCRIPT_TIMEOUT="60"
